<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Nghi Phep - Leave Request -->
        
        <!-- Tree View -->
        <record id="nghi_phep_tree" model="ir.ui.view">
            <field name="name">nghi_phep.tree</field>
            <field name="model">nghi_phep</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="ma_nghi_phep"/>
                    <field name="nhan_vien_id"/>
                    <field name="loai_nghi_phep"/>
                    <field name="ngay_bat_dau"/>
                    <field name="ngay_ket_thuc"/>
                    <field name="so_ngay"/>
                    <field name="trang_thai"/>
                </tree>
            </field>
        </record>
        
        <!-- Form View -->
        <record id="nghi_phep_form" model="ir.ui.view">
            <field name="name">nghi_phep.form</field>
            <field name="model">nghi_phep</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_submit" string="Nộp đơn" type="object" class="oe_highlight" attrs="{'invisible': [('trang_thai', '!=', 'cho_duyet')]}"/>
                        <button name="action_approve_level_1" string="Duyệt cấp 1" type="object" class="oe_highlight" attrs="{'invisible': [('trang_thai', '!=', 'cho_duyet')]}"/>
                        <button name="action_approve_level_2" string="Duyệt cấp 2" type="object" class="oe_highlight" attrs="{'invisible': [('trang_thai', '!=', 'duyet_cap_1')]}"/>
                        <button name="action_reject" string="Từ chối" type="object" attrs="{'invisible': [('trang_thai', 'not in', ['cho_duyet', 'duyet_cap_1'])]}"/>
                        <button name="action_cancel" string="Hủy" type="object" attrs="{'invisible': [('trang_thai', 'in', ['huy_bo', 'tu_choi'])]}"/>
                        <field name="trang_thai" widget="statusbar" options="{'clickable': False}"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="ma_nghi_phep" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="nhan_vien_id"/>
                                <field name="loai_nghi_phep"/>
                                <field name="ngay_bat_dau"/>
                                <field name="ngay_ket_thuc"/>
                                <field name="so_ngay" readonly="1"/>
                                <field name="so_ngay_lam_viec" readonly="1"/>
                            </group>
                            <group>
                                <field name="ngay_nop_don"/>
                                <field name="so_dien_thoai_lien_he"/>
                                <field name="nguoi_thay_the_id"/>
                            </group>
                        </group>
                        <group>
                            <field name="ly_do"/>
                            <field name="ghi_chu"/>
                        </group>
                        <group>
                            <group>
                                <field name="nguoi_duyet_cap_1_id" readonly="1"/>
                                <field name="ngay_duyet_cap_1" readonly="1"/>
                                <field name="ghi_chu_duyet_cap_1"/>
                            </group>
                            <group>
                                <field name="nguoi_duyet_cap_2_id" readonly="1"/>
                                <field name="ngay_duyet_cap_2" readonly="1"/>
                                <field name="ghi_chu_duyet_cap_2"/>
                            </group>
                        </group>
                        <group attrs="{'invisible': [('loai_nghi_phep', '!=', 'om')]}">
                            <field name="file_giay_to" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- Kanban View -->
        <record id="nghi_phep_kanban" model="ir.ui.view">
            <field name="name">nghi_phep.kanban</field>
            <field name="model">nghi_phep</field>
            <field name="arch" type="xml">
                <kanban default_group_by="trang_thai">
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="oe_kanban_details">
                                    <strong><field name="nhan_vien_id"/></strong>
                                    <p><field name="loai_nghi_phep"/></p>
                                    <small>
                                        <field name="ngay_bat_dau"/> - <field name="ngay_ket_thuc"/>
                                    </small>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        
        <!-- Action -->
        <record id="nghi_phep_action" model="ir.actions.act_window">
            <field name="name">Đơn xin nghỉ phép</field>
            <field name="res_model">nghi_phep</field>
            <field name="view_mode">kanban,tree,form</field>
        </record>
        
        <!-- Menu -->
        <menuitem id="nghi_phep_menu" parent="menu_ops_nhan_su" name="Đơn xin nghỉ phép" action="nghi_phep_action"/>
    </data>
</odoo>
