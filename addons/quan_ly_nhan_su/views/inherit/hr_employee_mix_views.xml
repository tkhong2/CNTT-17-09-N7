<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_form_mix_quan_ly_nhan_su" model="ir.ui.view">
        <field name="name">hr.employee.form.mix.quan_ly_nhan_su</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_open_nhan_vien_custom" class="oe_stat_button" icon="fa-id-card-o">
                    <field name="nhan_vien_custom_count" string="HS Noi bo" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Lien ket Nhan su Noi bo">
                    <group>
                        <field name="nhan_vien_custom_id" readonly="1" options="{'no_open': False}"/>
                    </group>
                </page>
                <page string="Gia dinh">
                    <field name="family_ids" context="{'default_employee_id': active_id}">
                        <tree editable="bottom">
                            <field name="name"/>
                            <field name="relationship"/>
                            <field name="birth_date"/>
                            <field name="age" readonly="1"/>
                            <field name="is_dependent" readonly="1"/>
                        </tree>
                    </field>
                </page>
                <page string="Qua trinh cong tac">
                    <field name="work_history_ids" context="{'default_employee_id': active_id}">
                        <tree editable="bottom">
                            <field name="company_name"/>
                            <field name="position"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_hr_employee_tree_mix_quan_ly_nhan_su" model="ir.ui.view">
        <field name="name">hr.employee.tree.mix.quan_ly_nhan_su</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="nhan_vien_custom_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
