<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!-- Cron 1: Kiểm tra hợp đồng sắp hết hạn - chạy hàng ngày 8:00 sáng -->
    <record id="cron_telegram_hop_dong" model="ir.cron">
      <field name="name">Telegram: Cảnh báo hợp đồng sắp hết hạn</field>
      <field name="model_id" ref="base.model_res_lang"/>
      <field name="state">code</field>
      <field name="code">env['telegram.config']._cron_notify_hop_dong_sap_het_han()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="numbercall">-1</field>
      <field name="active">True</field>
      <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).replace(hour=8, minute=0, second=0).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

    <!-- Cron 2: Báo cáo hàng ngày - 7:30 sáng -->
    <record id="cron_telegram_daily" model="ir.cron">
      <field name="name">Telegram: Báo cáo hàng ngày</field>
      <field name="model_id" ref="base.model_res_lang"/>
      <field name="state">code</field>
      <field name="code">env['telegram.config']._cron_daily_report()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="numbercall">-1</field>
      <field name="active">True</field>
      <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).replace(hour=7, minute=30, second=0).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

  </data>
</odoo>
