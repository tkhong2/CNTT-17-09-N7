<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="cong_viec_dashboard_main" model="cong_viec_dashboard">
            <field name="ten_bang">Dashboard KPI Công việc</field>
        </record>

        <record id="view_cong_viec_dashboard_form" model="ir.ui.view">
            <field name="name">cong_viec_dashboard.form</field>
            <field name="model">cong_viec_dashboard</field>
            <field name="arch" type="xml">
                <form create="0" edit="0" delete="0">
                    <sheet>
                        <div class="erp-dashboard-page">
                            <div class="erp-dashboard-title">
                                <h1><field name="ten_bang" readonly="1" nolabel="1"/></h1>
                            </div>

                            <div class="erp-kpi-grid erp-kpi-grid-3">
                                <div class="erp-kpi-card">
                                    <div class="erp-kpi-label">Công việc đang mở</div>
                                    <div class="erp-kpi-value"><field name="tong_cong_viec_active" readonly="1" nolabel="1"/></div>
                                </div>
                                <div class="erp-kpi-card">
                                    <div class="erp-kpi-label">Công việc bị chặn</div>
                                    <div class="erp-kpi-value"><field name="tong_cong_viec_bi_chan" readonly="1" nolabel="1"/></div>
                                </div>
                                <div class="erp-kpi-card">
                                    <div class="erp-kpi-label">Tỷ lệ blocked</div>
                                    <div class="erp-kpi-value"><field name="blocked_task_ratio" readonly="1" nolabel="1" widget="percentage"/></div>
                                </div>
                            </div>

                            <div class="erp-panel-grid">
                                <div class="erp-panel">
                                    <div class="erp-panel-header green">Task Health</div>
                                    <div class="erp-panel-body">
                                        <div class="erp-metric">
                                            <div class="erp-metric-label">Tổng công việc đang mở</div>
                                            <div class="erp-metric-value"><field name="tong_cong_viec_active" readonly="1" nolabel="1"/></div>
                                        </div>
                                        <div class="erp-metric">
                                            <div class="erp-metric-label">Task đang bị chặn</div>
                                            <div class="erp-metric-value"><field name="tong_cong_viec_bi_chan" readonly="1" nolabel="1"/></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="erp-panel">
                                    <div class="erp-panel-header orange">Blocked Ratio</div>
                                    <div class="erp-panel-body one-col">
                                        <div class="erp-metric">
                                            <div class="erp-metric-label">Tỷ lệ blocked trên task đang mở</div>
                                            <div class="erp-metric-value"><field name="blocked_task_ratio" readonly="1" nolabel="1" widget="percentage"/></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="erp-action-row">
                                <button type="object" name="action_xem_cong_viec_bi_chan" class="btn btn-primary" icon="fa-ban" string="Xem công việc bị chặn"/>
                            </div>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_cong_viec_dashboard" model="ir.actions.act_window">
            <field name="name">Dashboard KPI</field>
            <field name="res_model">cong_viec_dashboard</field>
            <field name="view_mode">form</field>
            <field name="res_id" ref="cong_viec_dashboard_main"/>
        </record>

        <menuitem id="menu_cong_viec_dashboard" name="Dashboard KPI" parent="menu_quan_ly_cong_viec_root" action="action_cong_viec_dashboard" sequence="0"/>
    </data>
</odoo>
