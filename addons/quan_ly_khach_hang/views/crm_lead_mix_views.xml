<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_form_mix_quan_ly_khach_hang" model="ir.ui.view">
        <field name="name">crm.lead.form.mix.quan_ly_khach_hang</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_open_lead_noi_bo" class="oe_stat_button" icon="fa-exchange">
                    <field name="lead_noi_bo_count" string="Lead Noi bo" widget="statinfo"/>
                </button>
                <button type="object" name="action_open_cong_viec_cham_soc" class="oe_stat_button" icon="fa-tasks" attrs="{'invisible': [('partner_id', '=', False)]}">
                    <field name="cong_viec_cham_soc_count" string="Cong viec" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Lien ket voi quan_ly_khach_hang" attrs="{'invisible': [('lead_noi_bo_id', '=', False)]}">
                    <group>
                        <field name="lead_noi_bo_id" readonly="1"/>
                        <field name="lead_noi_bo_trang_thai" readonly="1"/>
                    </group>
                    <group>
                        <field name="lead_noi_bo_diem" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
