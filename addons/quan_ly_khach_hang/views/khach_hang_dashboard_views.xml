<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_khach_hang_dashboard_form" model="ir.ui.view">
        <field name="name">khach_hang_dashboard.form</field>
        <field name="model">khach_hang_dashboard</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <sheet>
                    <div class="erp-dashboard-page">
                        <div class="erp-dashboard-title">
                            <h1><field name="ten_bang" readonly="1" nolabel="1"/></h1>
                        </div>

                        <div class="erp-kpi-grid erp-kpi-grid-6">
                            <div class="erp-kpi-card">
                                <div class="erp-kpi-label">Tổng khách hàng</div>
                                <div class="erp-kpi-value"><field name="tong_khach_hang" readonly="1" nolabel="1"/></div>
                            </div>
                            <div class="erp-kpi-card">
                                <div class="erp-kpi-label">Mới 7 ngày</div>
                                <div class="erp-kpi-value"><field name="khach_hang_moi_7_ngay" readonly="1" nolabel="1"/></div>
                            </div>
                            <div class="erp-kpi-card">
                                <div class="erp-kpi-label">Đang hợp tác</div>
                                <div class="erp-kpi-value"><field name="khach_hang_dang_hop_tac" readonly="1" nolabel="1"/></div>
                            </div>
                            <div class="erp-kpi-card">
                                <div class="erp-kpi-label">Follow-up quá hạn</div>
                                <div class="erp-kpi-value"><field name="followup_qua_han" readonly="1" nolabel="1"/></div>
                            </div>
                            <div class="erp-kpi-card">
                                <div class="erp-kpi-label">Ticket quá hạn SLA</div>
                                <div class="erp-kpi-value"><field name="ticket_qua_han_sla" readonly="1" nolabel="1"/></div>
                            </div>
                            <div class="erp-kpi-card">
                                <div class="erp-kpi-label">Tỷ lệ SLA breach</div>
                                <div class="erp-kpi-value"><field name="sla_breach_rate" readonly="1" nolabel="1" widget="percentage"/></div>
                            </div>
                        </div>

                        <div class="erp-panel-grid">
                            <div class="erp-panel">
                                <div class="erp-panel-header blue">Tổng quan khách hàng</div>
                                <div class="erp-panel-body">
                                    <div class="erp-metric">
                                        <div class="erp-metric-label">Chưa phân công</div>
                                        <div class="erp-metric-value"><field name="khach_hang_chua_phan_cong" readonly="1" nolabel="1"/></div>
                                    </div>
                                    <div class="erp-metric">
                                        <div class="erp-metric-label">Im lặng hơn 14 ngày</div>
                                        <div class="erp-metric-value"><field name="khach_hang_im_lang_14_ngay" readonly="1" nolabel="1"/></div>
                                    </div>
                                    <div class="erp-metric">
                                        <div class="erp-metric-label">Trùng liên hệ</div>
                                        <div class="erp-metric-value"><field name="khach_hang_trung_lien_he" readonly="1" nolabel="1"/></div>
                                    </div>
                                    <div class="erp-metric">
                                        <div class="erp-metric-label">Đề xuất gộp chờ duyệt</div>
                                        <div class="erp-metric-value"><field name="de_xuat_gop_cho_duyet" readonly="1" nolabel="1"/></div>
                                    </div>
                                </div>
                            </div>

                            <div class="erp-panel">
                                <div class="erp-panel-header teal">Hiệu quả chăm sóc</div>
                                <div class="erp-panel-body">
                                    <div class="erp-metric">
                                        <div class="erp-metric-label">Tổng tương tác</div>
                                        <div class="erp-metric-value"><field name="tong_tuong_tac" readonly="1" nolabel="1"/></div>
                                    </div>
                                    <div class="erp-metric">
                                        <div class="erp-metric-label">Tương tác chốt</div>
                                        <div class="erp-metric-value"><field name="tuong_tac_chot_hop_dong" readonly="1" nolabel="1"/></div>
                                    </div>
                                    <div class="erp-metric">
                                        <div class="erp-metric-label">Tỷ lệ chốt</div>
                                        <div class="erp-metric-value"><field name="ty_le_chot" readonly="1" nolabel="1" widget="percentage"/></div>
                                    </div>
                                    <div class="erp-metric">
                                        <div class="erp-metric-label">Ticket đang mở</div>
                                        <div class="erp-metric-value"><field name="tong_ticket_ho_tro" readonly="1" nolabel="1"/></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="erp-action-row">
                            <button type="object" name="action_chay_nhanh_theo_mau" class="btn btn-primary" icon="fa-bolt" string="Chạy nhanh theo mẫu" groups="quan_ly_khach_hang.group_khach_hang_manager"/>
                            <button type="object" name="action_tu_dong_phan_cong" class="btn btn-secondary" icon="fa-random" string="Tự động phân công" groups="quan_ly_khach_hang.group_khach_hang_manager"/>
                            <button type="object" name="action_gui_bao_cao_ngay" class="btn btn-secondary" icon="fa-envelope" string="Gửi báo cáo ngày" groups="quan_ly_khach_hang.group_khach_hang_manager"/>
                            <button type="object" name="action_gui_canh_bao_backlog" class="btn btn-secondary" icon="fa-bell" string="Cảnh báo backlog" groups="quan_ly_khach_hang.group_khach_hang_manager"/>
                            <button type="object" name="action_xem_khach_hang_chua_phan_cong" class="btn btn-link" string="Xem khách hàng chưa phân công" groups="quan_ly_khach_hang.group_khach_hang_manager"/>
                            <button type="object" name="action_xem_ticket_qua_han_sla" class="btn btn-link" string="Xem ticket quá hạn SLA" groups="quan_ly_khach_hang.group_khach_hang_sales,quan_ly_khach_hang.group_khach_hang_manager"/>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_khach_hang_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard KPI</field>
        <field name="res_model">khach_hang_dashboard</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="quan_ly_khach_hang.khach_hang_dashboard_main"/>
    </record>

    <menuitem id="menu_khach_hang_dashboard" name="Dashboard KPI" parent="menu_quan_ly_khach_hang_root" action="action_khach_hang_dashboard" sequence="0" groups="quan_ly_khach_hang.group_khach_hang_sales,quan_ly_khach_hang.group_khach_hang_manager"/>
</odoo>
