<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_khach_hang_dashboard_form" model="ir.ui.view">
    <field name="name">khach_hang_dashboard.form</field>
    <field name="model">khach_hang_dashboard</field>
    <field name="arch" type="xml">
      <form create="0" delete="0" edit="0">
        <sheet>
          <div class="erp-dashboard-page">

            <!-- HEADER -->
            <div class="erp-dash-header">
              <div class="erp-dash-header-left">
                <h1><field name="ten_bang" readonly="1" nolabel="1"/></h1>
                <p>Tổng quan chăm sóc &amp; phát triển khách hàng</p>
              </div>
              <div class="erp-action-row">
                <button type="object" name="action_chay_nhanh_theo_mau"
                  class="oe_highlight" string="Chạy nhanh theo mẫu"
                  groups="quan_ly_khach_hang.group_khach_hang_manager"/>
                <button type="object" name="action_tu_dong_phan_cong"
                   string="Tự động phân công"
                  groups="quan_ly_khach_hang.group_khach_hang_manager"/>
              </div>
            </div>

            <!-- KPI ROW 1: 3 cột -->
            <div class="erp-kpi-row erp-kpi-row-3">
              <div class="erp-kpi-card erp-kpi-c1">
                <div class="erp-kpi-icon"><i class="fa fa-users fa-lg"/></div>
                <div class="erp-kpi-label">Tổng khách hàng</div>
                <div class="erp-kpi-val"><field name="tong_khach_hang" readonly="1" nolabel="1"/></div>
                <span class="erp-kpi-tag">Tất cả</span>
              </div>
              <div class="erp-kpi-card erp-kpi-c2">
                <div class="erp-kpi-icon"><i class="fa fa-user-plus fa-lg"/></div>
                <div class="erp-kpi-label">Khách mới 7 ngày</div>
                <div class="erp-kpi-val"><field name="khach_hang_moi_7_ngay" readonly="1" nolabel="1"/></div>
                <span class="erp-kpi-tag">Tuần này</span>
              </div>
              <div class="erp-kpi-card erp-kpi-c2">
                <div class="erp-kpi-icon"><i class="fa fa-handshake-o fa-lg"/></div>
                <div class="erp-kpi-label">Đang hợp tác</div>
                <div class="erp-kpi-val"><field name="khach_hang_dang_hop_tac" readonly="1" nolabel="1"/></div>
                <span class="erp-kpi-tag">Active</span>
              </div>
            </div>

            <!-- KPI ROW 2: 3 cột -->
            <div class="erp-kpi-row erp-kpi-row-3">
              <div class="erp-kpi-card erp-kpi-c3">
                <div class="erp-kpi-icon"><i class="fa fa-clock-o fa-lg"/></div>
                <div class="erp-kpi-label">Follow-up quá hạn</div>
                <div class="erp-kpi-val"><field name="followup_qua_han" readonly="1" nolabel="1"/></div>
                <span class="erp-kpi-tag">Cần xử lý</span>
              </div>
              <div class="erp-kpi-card erp-kpi-c4">
                <div class="erp-kpi-icon"><i class="fa fa-ticket fa-lg"/></div>
                <div class="erp-kpi-label">Ticket quá hạn SLA</div>
                <div class="erp-kpi-val"><field name="ticket_qua_han_sla" readonly="1" nolabel="1"/></div>
                <span class="erp-kpi-tag">Vi phạm SLA</span>
              </div>
              <div class="erp-kpi-card erp-kpi-c4">
                <div class="erp-kpi-icon"><i class="fa fa-line-chart fa-lg"/></div>
                <div class="erp-kpi-label">Tỷ lệ SLA Breach</div>
                <div class="erp-kpi-val"><field name="sla_breach_rate" readonly="1" nolabel="1" widget="percentage"/></div>
                <span class="erp-kpi-tag">SLA</span>
              </div>
            </div>

            <!-- STAT PANELS -->
            <div class="erp-stat-row">
              <div class="erp-stat-box">
                <div class="erp-stat-head"><i class="fa fa-users"/> Tổng quan khách hàng</div>
                <div class="erp-stat-body">
                  <div class="erp-stat-item">
                    <div class="erp-stat-item-label">Chưa phân công</div>
                    <div class="erp-stat-item-val"><field name="khach_hang_chua_phan_cong" readonly="1" nolabel="1"/></div>
                  </div>
                  <div class="erp-stat-item">
                    <div class="erp-stat-item-label">Im lặng &gt;14 ngày</div>
                    <div class="erp-stat-item-val"><field name="khach_hang_im_lang_14_ngay" readonly="1" nolabel="1"/></div>
                  </div>
                  <div class="erp-stat-item">
                    <div class="erp-stat-item-label">Trùng liên hệ</div>
                    <div class="erp-stat-item-val"><field name="khach_hang_trung_lien_he" readonly="1" nolabel="1"/></div>
                  </div>
                  <div class="erp-stat-item">
                    <div class="erp-stat-item-label">Đề xuất gộp chờ duyệt</div>
                    <div class="erp-stat-item-val"><field name="de_xuat_gop_cho_duyet" readonly="1" nolabel="1"/></div>
                  </div>
                </div>
              </div>
              <div class="erp-stat-box">
                <div class="erp-stat-head"><i class="fa fa-line-chart"/> Hiệu quả chăm sóc</div>
                <div class="erp-stat-body">
                  <div class="erp-stat-item">
                    <div class="erp-stat-item-label">Tổng tương tác</div>
                    <div class="erp-stat-item-val"><field name="tong_tuong_tac" readonly="1" nolabel="1"/></div>
                  </div>
                  <div class="erp-stat-item">
                    <div class="erp-stat-item-label">Tương tác chốt HĐ</div>
                    <div class="erp-stat-item-val"><field name="tuong_tac_chot_hop_dong" readonly="1" nolabel="1"/></div>
                  </div>
                  <div class="erp-stat-item">
                    <div class="erp-stat-item-label">Tỷ lệ chốt</div>
                    <div class="erp-stat-item-val"><field name="ty_le_chot" readonly="1" nolabel="1" widget="percentage"/></div>
                  </div>
                  <div class="erp-stat-item">
                    <div class="erp-stat-item-label">Ticket đang mở</div>
                    <div class="erp-stat-item-val"><field name="tong_ticket_ho_tro" readonly="1" nolabel="1"/></div>
                  </div>
                </div>
              </div>
            </div>

            <!-- ACTIONS -->
            <div class="erp-action-row">
              <button type="object" name="action_gui_bao_cao_ngay" 
                string="Gửi báo cáo ngày"
                groups="quan_ly_khach_hang.group_khach_hang_manager"/>
              <button type="object" name="action_xem_khach_hang_chua_phan_cong" 
                string="KH chưa phân công"
                groups="quan_ly_khach_hang.group_khach_hang_manager"/>
              <button type="object" name="action_xem_ticket_qua_han_sla" 
                string="Ticket quá hạn SLA"
                groups="quan_ly_khach_hang.group_khach_hang_sales,quan_ly_khach_hang.group_khach_hang_manager"/>
            </div>

          </div>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_khach_hang_dashboard" model="ir.actions.act_window">
    <field name="name">Dashboard KPI Khách hàng</field>
    <field name="res_model">khach_hang_dashboard</field>
    <field name="view_mode">form</field>
    <field name="res_id" ref="quan_ly_khach_hang.khach_hang_dashboard_main"/>
  </record>

  <menuitem id="menu_khach_hang_dashboard" name="Dashboard KPI"
    parent="menu_quan_ly_khach_hang_root"
    action="action_khach_hang_dashboard" sequence="0"
    groups="quan_ly_khach_hang.group_khach_hang_sales,quan_ly_khach_hang.group_khach_hang_manager"/>
</odoo>
