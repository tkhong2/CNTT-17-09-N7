<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Actions -->
        <record id="action_bao_gia" model="ir.actions.act_window">
            <field name="name">Báo Giá</field>
            <field name="res_model">bao_gia</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Quotation (Báo Giá) Views -->
        <record id="view_bao_gia_tree" model="ir.ui.view">
            <field name="name">bao_gia.tree</field>
            <field name="model">bao_gia</field>
            <field name="arch" type="xml">
                <tree string="Báo Giá">
                    <field name="ma_bao_gia"/>
                    <field name="khach_hang_id"/>
                    <field name="nhan_vien_phu_trach_id"/>
                    <field name="ngay_tao"/>
                    <field name="tong_tien" sum="Tổng"/>
                    <field name="trang_thai"/>
                </tree>
            </field>
        </record>
        
        <record id="view_bao_gia_form" model="ir.ui.view">
            <field name="name">bao_gia.form</field>
            <field name="model">bao_gia</field>
            <field name="arch" type="xml">
                <form string="Báo Giá">
                    <header>
                        <button name="action_submit_approval" string="Nộp Duyệt" type="object" class="btn-primary"/>
                        <button name="action_approve" string="Duyệt" type="object"/>
                        <button name="action_send" string="Gửi Khách" type="object" class="btn-primary"/>
                        <button name="action_mark_accepted" string="Khách Chấp Nhận" type="object"/>
                        <button name="action_convert_to_order" string="Tạo Đơn Hàng" type="object" class="btn-success"/>
                        <field name="trang_thai" widget="statusbar"/>
                    </header>
                    <sheet>
                        
                        <div class="oe_title">
                            <h1>
                                <field name="ma_bao_gia" readonly="1"/>
                            </h1>
                        </div>
                        
                        <group>
                            <group>
                                <field name="khach_hang_id"/>
                                <field name="co_hoi_id"/>
                                <field name="nhan_vien_phu_trach_id"/>
                            </group>
                            <group>
                                <field name="ngay_tao" readonly="1"/>
                                <field name="ngay_hieu_luc"/>
                                <field name="ngay_het_hieu_luc"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Chi Tiết Báo Giá">
                                <field name="chi_tiet_ids" nolabel="1" colspan="2">
                                    <tree string="Chi Tiết" editable="bottom">
                                        <field name="ten_san_pham"/>
                                        <field name="don_vi"/>
                                        <field name="so_luong"/>
                                        <field name="don_gia"/>
                                        <field name="thanh_tien"/>
                                    </tree>
                                    <form string="Chi Tiết Báo Giá">
                                        <group>
                                            <field name="ten_san_pham"/>
                                            <field name="don_vi"/>
                                            <field name="so_luong"/>
                                            <field name="don_gia"/>
                                            <field name="thanh_tien" readonly="1"/>
                                        </group>
                                        <group>
                                            <field name="mo_ta" colspan="2"/>
                                        </group>
                                    </form>
                                </field>
                            </page>
                            
                            <page string="Tính Toán">
                                <group>
                                    <group>
                                        <field name="tong_tien_hang" readonly="1"/>
                                        <field name="chiet_khau_phan_tram"/>
                                        <field name="chiet_khau_tien" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="tien_sau_chiet_khau" readonly="1"/>
                                        <field name="thue_vat"/>
                                        <field name="tien_thue_vat" readonly="1"/>
                                    </group>
                                </group>
                                <field name="tong_tien" readonly="1" widget="monetary"/>
                            </page>
                            
                            <page string="Thanh Toán">
                                <group>
                                    <field name="hinh_thuc_thanh_toan"/>
                                    <field name="so_tien_coc"/>
                                </group>
                                <field name="dieu_khoan" colspan="2"/>
                            </page>
                            
                            <page string="Ghi Chú">
                                <field name="ghi_chu" colspan="2"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_ids" widget="mail_thread"/>
                        <field name="activity_ids" widget="mail_activity"/>
                    </div>
                </form>
            </field>
        </record>
        
        <record id="view_bao_gia_search" model="ir.ui.view">
            <field name="name">bao_gia.search</field>
            <field name="model">bao_gia</field>
            <field name="arch" type="xml">
                <search string="Báo Giá">
                    <field name="ma_bao_gia"/>
                    <field name="khach_hang_id"/>
                    <field name="nhan_vien_phu_trach_id"/>
                    <separator/>
                    <filter string="Nháp" name="draft" domain="[('trang_thai', '=', 'draft')]"/>
                    <filter string="Chờ Duyệt" name="pending" domain="[('trang_thai', '=', 'pending_approval')]"/>
                    <filter string="Đã Gửi" name="sent" domain="[('trang_thai', '=', 'sent')]"/>
                    <filter string="Đã Chấp Nhận" name="accepted" domain="[('trang_thai', '=', 'accepted')]"/>
                </search>
            </field>
        </record>
    </data>
</odoo>